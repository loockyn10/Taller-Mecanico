{
  "name": "fierro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fierro — gestión de talleres mecánicos (multiempresa, Cloudflare Workers + D1)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset-local.mjs",
    "demo": "node scripts/demo/index.mjs",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run && vitest run --config vitest.api.config.ts",
    "test:unit": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "platform": "node scripts/platform.mjs",
    "verificar:online": "node scripts/verificar-online.mjs",
    "respaldo": "node scripts/respaldo.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.75.0",
    "hono": "4.7.7",
    "lucide-react": "0.503.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@tailwindcss/vite": "4.1.4",
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "tailwindcss": "4.1.4",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.1.2",
    "wrangler": "4.145.0"
  }
}