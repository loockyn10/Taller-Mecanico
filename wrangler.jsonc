{
  // Fierro: API (Hono) + SPA servida como assets estáticos desde el mismo Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fierro",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // /seguimiento/*: página pública de seguimiento de órdenes (la genera el Worker para controlar cabeceras: sin caché, sin indexación, sin Referer).
    "run_worker_first": ["/api/*", "/seguimiento/*"]
  },
  "d1_databases": [
  {
    "binding": "DB",
    "database_name": "taller_mecanico",
    "database_id": "28303459-b3e9-418b-894a-64f3a3993188",
    "migrations_dir": "migrations"
  }
],
  // Fotografías (Sprint 16): bucket R2 PRIVADO (sin acceso r2.dev ni dominios). Debe existir en la cuenta: un binding a un bucket inexistente
  // hace fallar el despliegue entero. En local y en las pruebas el bucket se simula en disco (scripts/lib.mjs › configLocal). Ver docs/FOTOGRAFIAS.md.
  "r2_buckets": [{ "binding": "FIERRO_FOTOS", "bucket_name": "fierro-fotos" }],
  // Mantenimiento periódico (gratis, incluido en el plan): drena la cola de contabilización, avanza reconciliaciones y deja un latido que la salud de plataforma vigila.
  // Dominio oficial (ya conectado a este Worker en Cloudflare; acá se conserva para los despliegues). La dirección workers.dev anterior sigue activa.
  "workers_dev": true,
  "routes": [{ "pattern": "taller.orvelan.com.ar", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PBKDF2_ITERATIONS": "100000",
    "SESSION_DAYS": "14"
  }
}
