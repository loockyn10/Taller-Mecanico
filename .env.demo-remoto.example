# Copiá este archivo como .env.demo-remoto (está ignorado por git) y completá los valores EN EL EDITOR.
# Nunca pegues estas contraseñas en el chat ni las escribas en comandos: el generador las lee de acá y no las imprime.

# Contraseña del usuario demo@fierro.local en la aplicación online
FIERRO_DEMO_PASSWORD=
# Contraseña que querés para pruebas@fierro.local (se establece al crear el Taller de Pruebas; mínimo 8 caracteres)
FIERRO_PRUEBAS_PASSWORD=
# Token de administración de plataforma (el secreto PLATFORM_ADMIN_TOKEN del Worker). Sólo para crear el Taller de Pruebas.
PLATFORM_ADMIN_TOKEN=
# Opcional: contraseña de los usuarios de ejemplo (administrador y empleado) de la demo. Si queda vacía, no se crean.
FIERRO_DEMO_PASSWORD_USUARIOS=
